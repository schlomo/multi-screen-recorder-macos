#!/usr/bin/env bash
# Builds the end-to-end test driver (the package's msr-end-to-end, never in
# the app bundle) and runs it against the app scripts/build-app built
# (docs/design/end-to-end-tests.md). A run records every screen and audio
# input of this Mac and adds a virtual screen: the Mac cannot be used
# meanwhile. All behaviour lives in the driver.
set -euo pipefail

me="scripts/end-to-end-test"
if [[ ${1-} == -h || ${1-} == --help ]]; then
    echo "Runs the end-to-end tests against build/Multi Screen Recorder.app (run scripts/build-app first).
  $me                          runs every scenario
  $me --scenario <name> ...    runs the named scenarios; repeat --scenario for more
  $me restore                  puts back what a run changed, should the driver have been killed
  $me state                    prints what a run may change (screens, default devices, BlackHole)
  $me --help                   prints this, also -h; $me run --help for the driver's own
Needs ffmpeg and ffprobe on the PATH, BlackHole 2ch installed, and the Screen & System Audio
Recording and Microphone permissions for the program running it (a terminal app)."
    exit 0
fi

command -v swift >/dev/null || { echo "$me: swift is not on the PATH" >&2; exit 1; }

cd "$(dirname "$0")/.."
swift build -c release --product msr-end-to-end
exec "$(swift build -c release --show-bin-path)/msr-end-to-end" "$@"
