#!/usr/bin/env bash
# Compiles msr, assembles the app bundle in build/ (the icon built from
# assets/icon/app-icon.png with sips and iconutil), signs it ad hoc with the
# options the real signing uses (hardened runtime, the entitlements), and
# archives it as build/msr-app.tar for the signing job: tar, because GitHub's
# artifact zip drops executable bits. Holds no secret and no identity;
# scripts/sign-app re-signs the bundle.
set -euo pipefail

for tool in swift plutil git codesign tar sips iconutil mktemp; do
    command -v "$tool" >/dev/null || { echo "scripts/build-app: $tool is not on the PATH" >&2; exit 1; }
done

cd "$(dirname "$0")/.."
version="$(scripts/version)"
short_version="${version%%[-+]*}"
commit="$(git rev-parse --short=7 HEAD)"
# The version's date: a rebuild of a commit gives the same banner.
build_date="$(scripts/version --build-date)"
bundle="Multi Screen Recorder.app"
app="build/$bundle"
archive="build/msr-app.tar"
icon_source="assets/icon/app-icon.png"
[[ -f "$icon_source" ]] || { echo "scripts/build-app: $icon_source is missing" >&2; exit 1; }

swift build -c release --product msr
bin_path="$(swift build -c release --product msr --show-bin-path)"

rm -rf build
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$bin_path/msr" "$app/Contents/MacOS/msr"
plist="$app/Contents/Info.plist"
cp Resources/Info.plist "$plist"
plutil -replace CFBundleShortVersionString -string "$short_version" "$plist"
plutil -replace CFBundleVersion -string "$short_version" "$plist"
plutil -replace MSRVersion -string "$version" "$plist"
plutil -replace MSRCommit -string "$commit" "$plist"
plutil -replace MSRBuildDate -string "$build_date" "$plist"

iconset="$(mktemp -d)/AppIcon.iconset"
trap 'rm -rf "$(dirname "$iconset")"' EXIT
mkdir "$iconset"
for size in 16 32 128 256 512; do
    sips -z "$size" "$size" "$icon_source" --out "$iconset/icon_${size}x${size}.png" >/dev/null
    sips -z "$((size * 2))" "$((size * 2))" "$icon_source" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
expected_files=10
[[ "$(find "$iconset" -name 'icon_*.png' | wc -l)" -eq "$expected_files" ]] \
    || { echo "scripts/build-app: the iconset does not hold exactly $expected_files icon files" >&2; exit 1; }
iconutil -c icns "$iconset" -o "$app/Contents/Resources/AppIcon.icns"

codesign --force --options runtime --timestamp=none \
    --entitlements Resources/msr.entitlements \
    --sign - "$app"
codesign --verify --deep --strict "$app"

tar --no-mac-metadata -cf "$archive" -C build "$bundle"
echo "$archive"
