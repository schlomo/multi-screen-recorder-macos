#!/usr/bin/env bash
# Compiles msr and assembles the unsigned app bundle in build/. Signing and
# zipping are scripts/sign-app, so in CI the signing key enters the keychain
# only after compilation has finished.
set -euo pipefail

for tool in swift plutil git; do
    command -v "$tool" >/dev/null || { echo "scripts/build-app: $tool is not on the PATH" >&2; exit 1; }
done

cd "$(dirname "$0")/.."
version="$(scripts/version)"
short_version="${version%%[-+]*}"
commit="$(git rev-parse --short=7 HEAD)"
app="build/Multi Screen Recorder.app"

swift build -c release
bin_path="$(swift build -c release --show-bin-path)"

rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp "$bin_path/msr" "$app/Contents/MacOS/msr"
plist="$app/Contents/Info.plist"
cp Resources/Info.plist "$plist"
plutil -replace CFBundleShortVersionString -string "$short_version" "$plist"
plutil -replace CFBundleVersion -string "$short_version" "$plist"
plutil -replace MSRVersion -string "$version" "$plist"
plutil -replace MSRCommit -string "$commit" "$plist"

echo "$app"
