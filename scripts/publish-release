#!/usr/bin/env bash
# Publishes the release for a merge to main: tag v<version>, with the zip that
# scripts/sign-app made with RELEASE_BUILD=true; the version is read from the
# bundle, where scripts/build-app wrote it. gh reads GH_TOKEN itself.
set -euo pipefail

for tool in gh git plutil; do
    command -v "$tool" >/dev/null || { echo "scripts/publish-release: $tool is not on the PATH" >&2; exit 1; }
done
if [[ "${RELEASE_BUILD:-}" != "true" ]]; then
    echo "scripts/publish-release: RELEASE_BUILD must be true" >&2
    exit 1
fi

cd "$(dirname "$0")/.."
if ! version="$(plutil -extract MSRVersion raw "build/Multi Screen Recorder.app/Contents/Info.plist")"; then
    echo "scripts/publish-release: cannot read MSRVersion from the bundle's Info.plist" >&2
    exit 1
fi
zip="build/Multi Screen Recorder ${version}.zip"
if [[ ! -f "$zip" ]]; then
    echo "scripts/publish-release: $zip does not exist; run scripts/build-app and scripts/sign-app first" >&2
    exit 1
fi

gh release create "v${version}" "$zip" \
    --target "$(git rev-parse HEAD)" \
    --title "Multi Screen Recorder ${version}" \
    --generate-notes
