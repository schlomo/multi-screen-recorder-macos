#!/usr/bin/env -S python3 -I
"""Prints the version of the current checkout. N is the number of commits on
origin/main, DATE the committer date of HEAD in UTC as YYYYMMDD:
  RELEASE_BUILD=true  0.<DATE>.<N>                    (HEAD must be origin/main,
                                                       with no uncommitted changes
                                                       to tracked files)
  PR_NUMBER=<n>       0.<DATE>.<N+1>-pr<n>+<commit>
  neither             0.<DATE>.<N+1>-dev+<commit>
Uncommitted changes to tracked files append .dirty to a local build,
0.<DATE>.<N+1>-dev+<commit>.dirty; a release or a snapshot stops on them.
Untracked files do not count.
With --build-date it prints DATE as YYYY-MM-DD instead, the build date the
bundle carries for the banner.
"""

import os
import re
import shutil
import subprocess
import sys
from datetime import UTC, date, datetime
from pathlib import Path
from typing import NoReturn

ME = "scripts/version"
MINIMUM_PYTHON = (3, 15)
if sys.version_info < MINIMUM_PYTHON:
    sys.exit(f"{ME}: needs Python {'.'.join(map(str, MINIMUM_PYTHON))} or later (the python3 of the macos-26 runner image),"
             f" not {sys.version.split()[0]}")

REPOSITORY = Path(__file__).resolve().parent.parent


def stop(message: str) -> NoReturn:
    sys.exit(f"{ME}: {message}")


def git(*arguments: str, failure: str | None = None) -> str:
    try:
        result = subprocess.run(["git", *arguments], cwd=REPOSITORY, check=True, stdout=subprocess.PIPE, text=True)
    except subprocess.CalledProcessError as error:
        stop(failure or f"git {' '.join(arguments)} failed with exit {error.returncode}")
    return result.stdout.strip()


def commit_date_utc() -> date:
    """The committer date of HEAD in UTC, independent of locale and time zone."""
    stamp = git("show", "-s", "--no-show-signature", "--format=%ct", "HEAD", failure="cannot read the commit date of HEAD")
    if not re.fullmatch(r"[0-9]+", stamp):
        stop(f"the commit date of HEAD is not a number of seconds: '{stamp}'")
    return datetime.fromtimestamp(int(stamp), UTC).date()


def has_uncommitted_changes() -> bool:
    return bool(git("status", "--porcelain", "--untracked-files=no", failure="cannot read the status of the checkout"))


def main() -> None:
    if shutil.which("git") is None:
        stop("git is not on the PATH")
    match sys.argv[1:]:
        case []:
            pass
        case ["--build-date"]:
            print(commit_date_utc().isoformat())
            return
        case ["--build-date", extra, *_]:
            stop(f"--build-date takes no further argument, not '{extra}'")
        case [argument, *_]:
            stop(f"unknown argument '{argument}'; the only one is --build-date")
    release_build = os.environ.get("RELEASE_BUILD", "")
    pr_number = os.environ.get("PR_NUMBER", "")
    if release_build not in ("", "true"):
        stop(f"RELEASE_BUILD must be true or unset, not '{release_build}'")
    if release_build and pr_number:
        stop("RELEASE_BUILD and PR_NUMBER exclude each other")
    if pr_number and not re.fullmatch(r"[1-9][0-9]*", pr_number):
        stop(f"PR_NUMBER must be a number, not '{pr_number}'")

    if git("rev-parse", "--is-shallow-repository") != "false":
        stop(f"{REPOSITORY} is a shallow clone, so the commits on origin/main cannot be counted; fetch its full history")
    main_commits = int(git("rev-list", "--count", "origin/main",
                           failure="cannot count the commits on origin/main; fetch it with its full history"))
    commit = git("rev-parse", "--short=7", "HEAD")

    date = commit_date_utc().strftime("%Y%m%d")
    dirty = has_uncommitted_changes()

    if pr_number and dirty:
        stop("a snapshot needs a checkout with no uncommitted changes to tracked files")
    if release_build:
        if git("rev-parse", "HEAD") != git("rev-parse", "origin/main"):
            stop(f"a release builds origin/main, but HEAD is {commit}")
        if dirty:
            stop("a release needs a checkout with no uncommitted changes to tracked files")
        print(f"0.{date}.{main_commits}")
        return
    suffix = f"pr{pr_number}" if pr_number else "dev"
    print(f"0.{date}.{main_commits + 1}-{suffix}+{commit}{'.dirty' if dirty else ''}")


if __name__ == "__main__":
    main()
