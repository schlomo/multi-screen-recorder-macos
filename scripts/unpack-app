#!/usr/bin/env bash
# Unpacks the app archive from scripts/build-app (the path given) into an
# empty build/, as data: the member checks and the writing are in
# Tools/unpack_app.py, so they rely on no tar's defaults and live in a real
# language rather than shell.
set -euo pipefail

me="scripts/unpack-app"
for tool in python3 realpath; do
    command -v "$tool" >/dev/null || { echo "$me: $tool is not on the PATH" >&2; exit 1; }
done
if [[ $# -ne 1 ]]; then
    echo "$me: give the path of the app archive" >&2
    exit 1
fi
archive="$(realpath "$1")"

cd "$(dirname "$0")/.."
exec python3 -I Tools/unpack_app.py "$archive" build
