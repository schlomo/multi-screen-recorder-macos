#!/usr/bin/env -S python3 -I
"""Creates or replaces the snapshot release of PR PR_NUMBER: a GitHub
pre-release tagged pr-<number> with the zip from scripts/sign-app, its
version read from the bundle, where scripts/build-app wrote it. Only
while the PR is open and its head is this commit: a run for a superseded
push or a closed PR publishes nothing and exits 0. gh reads GH_TOKEN itself.
"""

import json
import os
import plistlib
import shutil
import subprocess
import sys
from pathlib import Path
from typing import NoReturn
from xml.parsers.expat import ExpatError

ME = "scripts/publish-snapshot-release"
MINIMUM_PYTHON = (3, 15)
if sys.version_info < MINIMUM_PYTHON:
    sys.exit(f"{ME}: needs Python {'.'.join(map(str, MINIMUM_PYTHON))} or later (the python3 of the macos-26 runner image),"
             f" not {sys.version.split()[0]}")


def stop(message: str) -> NoReturn:
    sys.exit(f"{ME}: {message}")


def bundled_version(info_plist: Path) -> str:
    """MSRVersion from the bundle's Info.plist, which must be a valid property list with a dictionary at its root."""
    try:
        info = plistlib.loads(info_plist.read_bytes())
    except (OSError, plistlib.InvalidFileException, ExpatError, ValueError) as error:
        stop(f"cannot read the bundle's Info.plist: {error}")
    if not isinstance(info, dict):
        stop("the bundle's Info.plist does not hold a dictionary")
    if not isinstance(info.get("MSRVersion"), str):
        stop("the bundle's Info.plist has no MSRVersion")
    return info["MSRVersion"]


def run(*arguments: str) -> str:
    """Runs a command and returns its output; its errors go to stderr."""
    try:
        return subprocess.run(arguments, check=True, stdout=subprocess.PIPE, text=True).stdout
    except subprocess.CalledProcessError as error:
        stop(f"{' '.join(arguments[:3])} failed with exit {error.returncode}")


def main() -> None:
    for tool in ("gh", "git"):
        if shutil.which(tool) is None:
            stop(f"{tool} is not on the PATH")
    pr_number = os.environ.get("PR_NUMBER", "")
    if not pr_number:
        stop("PR_NUMBER is not set")

    os.chdir(Path(__file__).resolve().parent.parent)
    version = bundled_version(Path("build/Multi Screen Recorder.app/Contents/Info.plist"))
    zip_file = Path(f"build/Multi Screen Recorder {version}.zip")
    tag = f"pr-{pr_number}"
    if not zip_file.is_file():
        stop(f"{zip_file} does not exist; run scripts/build-app and scripts/sign-app first")

    head = run("git", "rev-parse", "HEAD").strip()
    pr = json.loads(run("gh", "pr", "view", pr_number, "--json", "state,headRefOid"))
    if pr["state"] != "OPEN":
        print(f"{ME}: PR #{pr_number} is {pr['state']}, not open; publishing nothing", file=sys.stderr)
        return
    if pr["headRefOid"] != head:
        print(f"{ME}: PR #{pr_number} is now at {pr['headRefOid']}, not {head}; publishing nothing", file=sys.stderr)
        return

    releases = json.loads(run("gh", "release", "list", "--limit", "1000", "--json", "tagName"))
    if tag in (release["tagName"] for release in releases):
        run("gh", "release", "delete", tag, "--yes", "--cleanup-tag")
    print(run(
        "gh", "release", "create", tag, str(zip_file),
        "--prerelease",
        "--target", head,
        "--title", f"Snapshot PR #{pr_number}: {version}",
        "--notes", f"Snapshot release of pull request #{pr_number}, replaced on every push"
                   " and removed when the pull request closes.",
    ), end="")


if __name__ == "__main__":
    main()
