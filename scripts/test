#!/usr/bin/env bash
# Compiles the Python scripts, then runs the unit tests. Needs Xcode selected
# with its licence accepted: the Command Line Tools alone cannot run Swift
# Testing.
set -euo pipefail

if [[ ${1-} == -h || ${1-} == --help ]]; then
    echo "Compiles the Python scripts, then runs the unit tests (swift test).
  scripts/test               runs all tests
  scripts/test <arguments>   passes the arguments to swift test, such as
                             --filter InstallAppScriptTests, or
                             --xunit-output <file> for JUnit XML (Swift
                             Testing's results go to <file>-swift-testing.xml)
  scripts/test --help        prints this, also -h; swift test --help for its own"
    exit 0
fi

# cc builds a stand-in program for the tests of scripts/install-app
for tool in swift xcodebuild python3 cc; do
    command -v "$tool" >/dev/null || { echo "scripts/test: $tool is not on the PATH" >&2; exit 1; }
done
if ! xcodebuild -license check >/dev/null; then
    echo "scripts/test: needs Xcode selected and its licence accepted, see Developer setup in README.md" >&2
    exit 1
fi

cd "$(dirname "$0")/.."
# swift test before 6.4 does not create the JUnit file's folder; after the
# cd, as swift test reads a relative path from here
arguments=("$@")
for index in "${!arguments[@]}"; do
    case ${arguments[index]} in
        --xunit-output) xunit=${arguments[index + 1]:?"scripts/test: --xunit-output needs a path"} ;;
        --xunit-output=*) xunit=${arguments[index]#--xunit-output=} ;;
        *) continue ;;
    esac
    mkdir -p "$(dirname "$xunit")"
done

python3 -I -m py_compile scripts/version scripts/unpack-app scripts/sign-app scripts/smoke-test \
    scripts/publish-snapshot-release
swift test "$@"
